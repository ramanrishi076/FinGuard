# FinGuard Client Environment Variables

# Backend API Base URL (Render URL with /api suffix in production)
# Example Local: http://localhost:5000/api
# Example Render: https://finguard-server.onrender.com/api
VITE_API_URL="http://localhost:5000/api"

# Real-Time WebSocket Server URL (Render URL without /api in production)
# Example Local: http://localhost:5000
# Example Render: https://finguard-server.onrender.com
VITE_SOCKET_URL="http://localhost:5000"
