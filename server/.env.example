# Database Connection (Neon Tech PostgreSQL or local Postgres)
# Example Neon Tech: postgresql://neondb_owner:npg_password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/finguard_db?schema=public"

# Authentication Secrets
JWT_SECRET="your_jwt_access_secret_super_secure_random_key"
JWT_ACCESS_SECRET="your_jwt_access_secret_super_secure_random_key"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_super_secure_random_key"
REFRESH_TOKEN_EXPIRES_DAYS=7

# Server Configuration
PORT=5000
NODE_ENV="development"

# Frontend Origin for CORS (Vercel deployment URL in production)
# Example Vercel: https://finguard-app.vercel.app
CLIENT_URL="http://localhost:5173"

# Distributed Caching & WebSockets (Upstash Redis or local Redis)
# Example Upstash: rediss://default:YOUR_UPSTASH_PASSWORD@subdomain.upstash.io:6379
# If omitted or offline, FinGuard automatically falls back to its resilient in-memory cache and pub/sub.
REDIS_URL="redis://localhost:6379"